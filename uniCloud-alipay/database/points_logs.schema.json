{
  "bsonType": "object",
  "required": ["user_id", "change", "balance", "reason"],
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": {
      "description": "ID，系统自动生成"
    },
    "user_id": {
      "bsonType": "string",
      "description": "用户 ID"
    },
    "change": {
      "bsonType": "int",
      "description": "积分变动（正=获得，负=消耗）"
    },
    "balance": {
      "bsonType": "int",
      "description": "变动后余额"
    },
    "reason": {
      "bsonType": "string",
      "enum": ["daily_check_in", "sticker_combo", "admin_adjust", "member_gift"],
      "description": "变动原因"
    },
    "note": {
      "bsonType": "string",
      "description": "备注"
    },
    "date_key": {
      "bsonType": "string",
      "description": "发生日期 YYYY-MM-DD",
      "maxLength": 10
    },
    "created_at": {
      "bsonType": "string",
      "description": "创建时间",
      "maxLength": 19
    }
  }
}
