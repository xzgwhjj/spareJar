{
  "bsonType": "object",
  "required": [
    "user_id",
    "nickname",
    "is_self",
    "created_at"
  ],
  "permission": {
    "read": "doc.user_id == auth.uid",
    "create": "doc.user_id == auth.uid",
    "update": "doc.user_id == auth.uid",
    "delete": "doc.user_id == auth.uid"
  },
  "properties": {
    "_id": {
      "description": "PK，成员全局唯一标识（跨账本复用）"
    },
    "user_id": {
      "bsonType": "string",
      "description": "FK→users.user_id",
      "maxLength": 64,
      "foreignKey": "users.user_id"
    },
    "is_self": {
      "bsonType": "bool",
      "description": "是否本人（每用户固定一条）",
      "defaultValue": false
    },
    "nickname": {
      "bsonType": "string",
      "description": "成员昵称",
      "maxLength": 64
    },
    "avatar": {
      "bsonType": "string",
      "description": "头像 URL"
    },
    "bio": {
      "bsonType": "string",
      "description": "成员简介/备注",
      "maxLength": 200
    },
    "relation": {
      "bsonType": "string",
      "description": "关系标识 self/family/partner/friend/child/colleague/other",
      "maxLength": 32,
      "defaultValue": "other"
    },
    "created_at": {
      "bsonType": "string",
      "description": "创建时间",
      "maxLength": 19
    }
  }
}