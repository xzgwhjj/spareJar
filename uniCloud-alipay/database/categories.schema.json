{
  "bsonType": "object",
  "required": [
    "user_id",
    "type",
    "name",
    "created_at"
  ],
  "permission": {
    "read": "doc.user_id == auth.uid",
    "create": "doc.user_id == auth.uid",
    "update": "doc.user_id == auth.uid",
    "delete": "doc.user_id == auth.uid"
  },
  "properties": {
    "_id": {
      "description": "PK"
    },
    "user_id": {
      "bsonType": "string",
      "description": "FK→users.user_id",
      "maxLength": 64,
      "foreignKey": "users.user_id"
    },
    "type": {
      "bsonType": "string",
      "enum": [
        "expense",
        "income"
      ],
      "description": "一级大类：支出/收入"
    },
    "name": {
      "bsonType": "string",
      "description": "分类名",
      "maxLength": 32
    },
    "icon": {
      "bsonType": "string",
      "description": "图标（emoji，icon_type=emoji 时展示）",
      "maxLength": 64,
      "defaultValue": "📦"
    },
    "icon_type": {
      "bsonType": "string",
      "enum": ["emoji", "image"],
      "description": "图标类型：emoji 系统图标 / image 用户自定义上传",
      "defaultValue": "emoji"
    },
    "icon_url": {
      "bsonType": "string",
      "description": "自定义图标地址（icon_type=image 时有效）",
      "maxLength": 512,
      "defaultValue": ""
    },
    "desc": {
      "bsonType": "string",
      "description": "分类简介/备注",
      "maxLength": 100,
      "defaultValue": ""
    },
    "is_system": {
      "bsonType": "bool",
      "description": "系统预置",
      "defaultValue": false
    },
    "is_hidden": {
      "bsonType": "bool",
      "description": "隐藏",
      "defaultValue": false
    },
    "sort_order": {
      "bsonType": "int",
      "description": "排序",
      "defaultValue": 0
    },
    "merged_to_id": {
      "bsonType": "string",
      "description": "FK→categories._id",
      "foreignKey": "categories._id"
    },
    "created_at": {
      "bsonType": "string",
      "description": "创建时间",
      "maxLength": 19
    },
    "updated_at": {
      "bsonType": "string",
      "description": "更新时间",
      "maxLength": 19
    },
    "deleted_at": {
      "bsonType": "string",
      "description": "软删时间（保留账单时账目仍引用该分类）",
      "maxLength": 19
    }
  }
}