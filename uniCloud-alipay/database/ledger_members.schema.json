{
  "bsonType": "object",
  "required": [
    "ledger_id"
  ],
  "permission": {
    "read": "doc.user_id == auth.uid || doc.user_id == null",
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": {
      "description": "PK（已废弃，迁移至 members + member_ledgers）"
    },
    "ledger_id": {
      "bsonType": "string",
      "description": "账本 ID",
      "foreignKey": "ledgers._id"
    },
    "user_id": {
      "bsonType": "string",
      "description": "成员 openid（已废弃）",
      "maxLength": 64,
      "foreignKey": "users.user_id",
      "nullable": true
    },
    "nickname": {
      "bsonType": "string",
      "description": "成员昵称（已废弃）",
      "maxLength": 64
    }
  }
}
