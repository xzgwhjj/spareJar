{
  "bsonType": "object",
  "required": [
    "user_id",
    "name",
    "target_amount",
    "created_at",
    "updated_at"
  ],
  "permission": {
    "read": "doc.user_id == auth.uid",
    "create": "doc.user_id == auth.uid",
    "update": "doc.user_id == auth.uid",
    "delete": "doc.user_id == auth.uid"
  },
  "properties": {
    "_id": {
      "description": "PK"
    },
    "user_id": {
      "bsonType": "string",
      "description": "FK→users.user_id",
      "maxLength": 64,
      "foreignKey": "users.user_id"
    },
    "name": {
      "bsonType": "string",
      "description": "心愿名称",
      "maxLength": 64
    },
    "target_amount": {
      "bsonType": "int",
      "description": "目标金额(分)",
      "minimum": 1
    },
    "saved_amount": {
      "bsonType": "int",
      "description": "已存(分)",
      "minimum": 0,
      "defaultValue": 0
    },
    "cover_image_url": {
      "bsonType": "string",
      "description": "封面图片 fileID / 系统图标(sys::idx) / 空（纯色封面）",
      "maxLength": 512
    },
    "cover_gradient": {
      "bsonType": "string",
      "description": "封面渐变色 linear-gradient(...)，任意封面类型都存",
      "maxLength": 256
    },
    "deadline": {
      "bsonType": "string",
      "description": "截止日期（兼容旧字段，等于 end_date）",
      "maxLength": 10
    },
    "start_date": {
      "bsonType": "string",
      "description": "心愿区间起始日期",
      "maxLength": 10
    },
    "end_date": {
      "bsonType": "string",
      "description": "心愿区间截止日期",
      "maxLength": 10
    },
    "start_time": {
      "bsonType": "string",
      "description": "心愿区间起始时间(HH:mm:ss)",
      "maxLength": 8
    },
    "end_time": {
      "bsonType": "string",
      "description": "心愿区间截止时间(HH:mm:ss)",
      "maxLength": 8
    },
    "status": {
      "bsonType": "string",
      "enum": [
        "active",
        "completed",
        "archived"
      ],
      "description": "状态",
      "defaultValue": "active"
    },
    "progress_pct": {
      "bsonType": "double",
      "description": "进度百分比",
      "minimum": 0,
      "maximum": 100,
      "defaultValue": 0
    },
    "completed_at": {
      "bsonType": "string",
      "description": "达成时间",
      "maxLength": 19
    },
    "archived_reason": {
      "bsonType": "string",
      "enum": [
        "completed",
        "deleted",
        "expired"
      ],
      "description": "归档原因：达成(completed)/手动删除(deleted)/过期未达成(expired)",
      "forceDefaultValue": "completed"
    },
    "sort_order": {
      "bsonType": "int",
      "description": "排序",
      "defaultValue": 0
    },
    "created_at": {
      "bsonType": "string",
      "description": "创建时间",
      "maxLength": 19
    },
    "updated_at": {
      "bsonType": "string",
      "description": "更新时间",
      "maxLength": 19
    }
  }
}