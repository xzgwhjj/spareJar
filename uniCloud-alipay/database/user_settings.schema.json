{
  "bsonType": "object",
  "required": [
    "user_id",
    "updated_at"
  ],
  "permission": {
    "read": "doc.user_id == auth.uid",
    "create": "doc.user_id == auth.uid",
    "update": "doc.user_id == auth.uid",
    "delete": "doc.user_id == auth.uid"
  },
  "properties": {
    "_id": {
      "description": "PK"
    },
    "user_id": {
      "bsonType": "string",
      "description": "FK→users.user_id",
      "maxLength": 64,
      "foreignKey": "users.user_id"
    },
    "daily_base_limit": {
      "bsonType": "int",
      "description": "日基准限额(分)",
      "minimum": 100,
      "defaultValue": 10000
    },
    "pending_base_limit": {
      "bsonType": "int",
      "description": "待生效限额(分)",
      "minimum": 100
    },
    "limit_effective_date": {
      "bsonType": "string",
      "description": "限额生效日",
      "maxLength": 10
    },
    "limit_amount_fen": {
      "bsonType": "int",
      "description": "主管控维度总池(分)，limit_dim=month/year 时生效",
      "minimum": 100
    },
    "limit_dim": {
      "bsonType": "string",
      "enum": [
        "day",
        "month",
        "year"
      ],
      "description": "主管控维度（day/month/year），默认 day",
      "defaultValue": "day"
    },
    "year_strategy": {
      "bsonType": "string",
      "enum": [
        "equal",
        "rollover"
      ],
      "description": "年→月 拆分策略（equal=均分, rollover=剩余滚动），仅 limit_dim=year 生效",
      "defaultValue": "equal"
    },
    "month_strategy": {
      "bsonType": "string",
      "enum": [
        "equal",
        "rollover"
      ],
      "description": "月→日 拆分策略（equal=均分, rollover=剩余滚动），limit_dim=month/year 生效",
      "defaultValue": "equal"
    },
    "pending_limit_dim": {
      "bsonType": "string",
      "enum": [
        "day",
        "month",
        "year"
      ],
      "description": "待生效主管控维度"
    },
    "pending_amount_fen": {
      "bsonType": "int",
      "description": "待生效总池(分)",
      "minimum": 100
    },
    "pending_year_strategy": {
      "bsonType": "string",
      "enum": [
        "equal",
        "rollover"
      ],
      "description": "待生效年→月策略"
    },
    "pending_month_strategy": {
      "bsonType": "string",
      "enum": [
        "equal",
        "rollover"
      ],
      "description": "待生效月→日策略"
    },
    "overrides": {
      "bsonType": "array",
      "description": "局部覆盖（day 最近7天 / month 最近1~3月），过期自动清理",
      "maxItems": 60,
      "item": {
        "bsonType": "object",
        "required": [
          "type",
          "key",
          "amount_fen",
          "expire_at"
        ],
        "properties": {
          "type": {
            "bsonType": "string",
            "enum": [
              "day",
              "month"
            ]
          },
          "key": {
            "bsonType": "string",
            "description": "日期(YYYY-MM-DD) 或 月份(YYYY-MM)",
            "maxLength": 10
          },
          "amount_fen": {
            "bsonType": "int",
            "minimum": 0
          },
          "expire_at": {
            "bsonType": "string",
            "description": "覆盖失效日(YYYY-MM-DD)，到期自动清理",
            "maxLength": 10
          }
        }
      }
    },
    "default_surplus_action": {
      "bsonType": "string",
      "enum": [
        "roll_over",
        "wish",
        "savings_pool"
      ],
      "description": "默认结余去向",
      "defaultValue": "roll_over"
    },
    "default_wish_id": {
      "bsonType": "string",
      "description": "FK→wishes._id",
      "foreignKey": "wishes._id"
    },
    "refund_restore_limit": {
      "bsonType": "bool",
      "description": "退款恢复限额",
      "defaultValue": true
    },
    "challenge_ledger_id": {
      "bsonType": "string",
      "description": "FK→ledgers._id",
      "foreignKey": "ledgers._id"
    },
    "max_custom_ledgers": {
      "bsonType": "int",
      "description": "自定义账本上限",
      "minimum": 0,
      "defaultValue": 5
    },
    "notify_over_limit": {
      "bsonType": "bool",
      "description": "超额通知",
      "defaultValue": true
    },
    "notify_daily_surplus": {
      "bsonType": "bool",
      "description": "日结通知",
      "defaultValue": true
    },
    "notify_streak_risk": {
      "bsonType": "bool",
      "description": "挑战中断通知",
      "defaultValue": true
    },
    "meal_tracking_enabled": {
      "bsonType": "bool",
      "description": "餐饮轻记录",
      "defaultValue": false
    },
    "fat_loss_mode_enabled": {
      "bsonType": "bool",
      "description": "减脂模式",
      "defaultValue": false
    },
    "savings_withdraw_limit_pct": {
      "bsonType": "int",
      "description": "月取出比例上限",
      "minimum": 1,
      "maximum": 100
    },
    "over_limit_penalty_enabled": {
      "bsonType": "bool",
      "description": "虚拟超额惩罚",
      "defaultValue": false
    },
    "penalty_streak_deduct": {
      "bsonType": "int",
      "description": "惩罚扣连续天数",
      "minimum": 0,
      "defaultValue": 1
    },
    "asset_view_mode": {
      "bsonType": "string",
      "enum": [
        "disposable",
        "with_investment",
        "full"
      ],
      "description": "总资产视图",
      "defaultValue": "disposable"
    },
    "updated_at": {
      "bsonType": "string",
      "description": "更新时间",
      "maxLength": 19
    }
  }
}