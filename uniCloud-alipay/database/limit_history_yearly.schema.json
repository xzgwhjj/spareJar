{
  "bsonType": "object",
  "required": [
    "user_id",
    "year"
  ],
  "permission": {
    "read": "doc.user_id == auth.uid",
    "create": "doc.user_id == auth.uid",
    "update": "doc.user_id == auth.uid",
    "delete": "doc.user_id == auth.uid"
  },
  "properties": {
    "_id": {
      "description": "PK"
    },
    "user_id": {
      "bsonType": "string",
      "description": "FK→users.user_id",
      "maxLength": 64,
      "foreignKey": "users.user_id"
    },
    "year": {
      "bsonType": "string",
      "description": "年度 YYYY",
      "maxLength": 4
    },
    "days_count": {
      "bsonType": "int",
      "description": "该年记录天数"
    },
    "months_tracked": {
      "bsonType": "int",
      "description": "该年有记录的自然月数量"
    },
    "total_day_limit_fen": {
      "bsonType": "int",
      "description": "全年每日额度合计(分)，日均= /days_count"
    },
    "year_limit_fen": {
      "bsonType": "int",
      "description": "当年年池上限(分)"
    },
    "total_spent_fen": {
      "bsonType": "int",
      "description": "全年实际花费合计(分)"
    },
    "total_surplus_fen": {
      "bsonType": "int",
      "description": "全年结余合计(分)"
    },
    "created_at": {
      "bsonType": "string",
      "description": "创建时间",
      "maxLength": 19
    },
    "updated_at": {
      "bsonType": "string",
      "description": "更新时间",
      "maxLength": 19
    }
  }
}